#
# https://help.github.com/articles/dealing-with-line-endings/
#
# Linux start script should use lf
/gradlew        text eol=lf

# These are Windows script files and should use crlf
*.bat           text eol=crlf

# Generated release artifacts (regenerated by semantic-release; do not hand-edit)
patches-list.json linguist-generated=true
patches-bundle.json linguist-generated=true
CHANGELOG.md linguist-generated=true
package-lock.json linguist-generated=true

# Vendored binary
gradle/wrapper/gradle-wrapper.jar linguist-vendored=true

# Documentation
docs/** linguist-documentation=true
*.md linguist-documentation=true

# Agent / CI tooling (support files, not product code)
.agents/** linguist-vendored=true
.opencode/** linguist-vendored=true
.claude/** linguist-vendored=true
.github/** linguist-vendored=true

